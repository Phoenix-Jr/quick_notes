<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="quick_note_stage_view_list" model="ir.ui.view">
        <field name="name">quick.note.stage.list</field>
        <field name="model">quick.note.stage</field>
        <field name="arch" type="xml">
            <list string="Statuts" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="quick_note_stage_view_form" model="ir.ui.view">
        <field name="name">quick.note.stage.form</field>
        <field name="model">quick.note.stage</field>
        <field name="arch" type="xml">
            <form string="Statut">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="fold"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="quick_note_stage_action" model="ir.actions.act_window">
        <field name="name">Statuts</field>
        <field name="res_model">quick.note.stage</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
